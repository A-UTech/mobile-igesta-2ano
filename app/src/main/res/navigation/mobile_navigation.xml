<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_tela_inicial">

    <fragment
        android:id="@+id/navigation_tela_inicial"
        android:name="com.example.igestamobile.ui.telainicial.TelaInicial"
        android:label="fragment_tela_inicial"
        tools:layout="@layout/fragment_tela_inicial" >
        <action
            android:id="@+id/action_navigation_tela_inicial_to_navigation_chatbot"
            app:destination="@id/navigation_chatbot"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_left"
            />
    </fragment>

    <fragment
        android:id="@+id/navigation_notifications"
        android:name="com.example.igestamobile.ui.contagem.ContagemFragment"
        android:label="@string/title_notifications"
        tools:layout="@layout/fragment_contagem" />

    <navigation
        android:id="@+id/navigation_perfil"
        app:startDestination="@id/fragment_perfil_base" >

        <fragment
            android:id="@+id/fragment_perfil_base"
            android:name="com.example.igestamobile.ui.perfil.Perfil"
            android:label="fragment_perfil"
            tools:layout="@layout/fragment_perfil" >

            <action
                android:id="@+id/action_perfil_to_configuracao"
                app:destination="@id/navigation_configuracao"
                app:enterAnim="@anim/slide_in_right"
                app:exitAnim="@anim/slide_out_left"
                app:popEnterAnim="@anim/slide_in_right"
                app:popExitAnim="@anim/slide_out_left"
                />
            <action
                android:id="@+id/action_perfil_to_gerenciarFuncionario"
                app:destination="@id/navigation_gerenciarFuncionario"
                app:enterAnim="@anim/slide_in_right"
                app:exitAnim="@anim/slide_out_left"
                app:popEnterAnim="@anim/slide_in_right"
                app:popExitAnim="@anim/slide_out_left"
                />
            <action
                android:id="@+id/action_navigation_perfil_to_navigation_historico"
                app:destination="@id/navigation_historico"
                app:enterAnim="@anim/slide_in_right"
                app:exitAnim="@anim/slide_out_left"
                app:popEnterAnim="@anim/slide_in_right"
                app:popExitAnim="@anim/slide_out_left"
                />
        </fragment>

        <fragment
            android:id="@+id/navigation_configuracao"
            android:name="com.example.igestamobile.ui.configuracao.Configuracao"
            android:label="fragment_configuracao"
            tools:layout="@layout/fragment_configuracao" />

        <fragment
            android:id="@+id/navigation_gerenciarFuncionario"
            android:name="com.example.igestamobile.ui.gerenciarfuncionario.GerenciarFuncionario"
            android:label="fragment_gerenciar_funcionario"
            tools:layout="@layout/fragment_gerenciar_funcionario" >
            <action
                android:id="@+id/action_navigation_gerenciarFuncionario_to_navigation_perfilFuncionario"
                app:destination="@id/navigation_perfilFuncionario"
                app:enterAnim="@anim/slide_in_right"
                app:exitAnim="@anim/slide_out_left"
                app:popEnterAnim="@anim/slide_in_right"
                app:popExitAnim="@anim/slide_out_left"
                />
        </fragment>

        <fragment
            android:id="@+id/navigation_perfilFuncionario"
            android:name="com.example.igestamobile.ui.perfilfuncionario.PerfilFuncionario"
            android:label="fragment_perfil_funcionario"
            tools:layout="@layout/fragment_perfil_funcionario" />

        <fragment
            android:id="@+id/navigation_historico"
            android:name="com.example.igestamobile.ui.historico.Historico"
            android:label="fragment_historico"
            tools:layout="@layout/fragment_historico" >
            <action
                android:id="@+id/action_navigation_historico_to_navigation_turnos"
                app:destination="@id/navigation_turnos"
                app:enterAnim="@anim/slide_in_right"
                app:exitAnim="@anim/slide_out_left"
                app:popEnterAnim="@anim/slide_in_right"
                app:popExitAnim="@anim/slide_out_left"
                />
        </fragment>

        <fragment
            android:id="@+id/navigation_turnos"
            android:name="com.example.igestamobile.ui.turnos.Turnos"
            android:label="fragment_turnos"
            tools:layout="@layout/fragment_turnos" />

    </navigation>

    <fragment
        android:id="@+id/navigation_chatbot"
        android:name="com.example.igestamobile.ui.chatbot.Chatbot"
        android:label="fragment_chatbot"
        tools:layout="@layout/fragment_chatbot" />

</navigation>
