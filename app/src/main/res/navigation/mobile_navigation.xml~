<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.igestamobile.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.example.igestamobile.ui.dashboard.DashboardFragment"
        android:label="@string/title_dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/navigation_notifications"
        android:name="com.example.igestamobile.ui.notifications.NotificationsFragment"
        android:label="@string/title_notifications"
        tools:layout="@layout/fragment_notifications" />

    <navigation
        android:id="@+id/navigation_perfil"
        app:startDestination="@id/navigation_perfil_base" >

        <fragment
            android:id="@+id/fragment_perfil_base"
            android:name="com.example.igestamobile.ui.Perfil"
            android:label="fragment_perfil"
            tools:layout="@layout/fragment_perfil" >

            <action
                android:id="@+id/action_perfil_to_configuracao"
                app:destination="@id/navigation_configuracao" />
            <action
                android:id="@+id/action_perfil_to_gerenciarFuncionario"
                app:destination="@id/navigation_gerenciarFuncionario" />
        </fragment>

        <fragment
            android:id="@+id/navigation_configuracao"
            android:name="com.example.igestamobile.ui.Configuracao"
            android:label="fragment_configuracao"
            tools:layout="@layout/fragment_configuracao" >
            <action
                android:id="@+id/action_navigation_perfil_to_navigation_configuracao"
                app:destination="@id/navigation_configuracao" />
        </fragment>

        <fragment
            android:id="@+id/navigation_gerenciarFuncionario"
            android:name="com.example.igestamobile.ui.GerenciarFuncionario"
            android:label="fragment_gerenciar_funcionario"
            tools:layout="@layout/fragment_gerenciar_funcionario" >
            <action
                android:id="@+id/action_navigation_gerenciarFuncionario_to_navigation_perfilFuncionario"
                app:destination="@id/navigation_perfilFuncionario" />
            <action
                android:id="@+id/action_navigation_perfil_to_navigation_gerenciarFuncionario"
                app:destination="@id/navigation_gerenciarFuncionario" />
        </fragment>
    </navigation>

    <fragment
        android:id="@+id/navigation_chatbot"
        android:name="com.example.igestamobile.Chatbot"
        android:label="fragment_chatbot"
        tools:layout="@layout/fragment_chatbot" />
    <fragment
        android:id="@+id/navigation_perfilFuncionario"
        android:name="com.example.igestamobile.PerfilFuncionario"
        android:label="fragment_perfil_funcionario"
        tools:layout="@layout/fragment_perfil_funcionario" />
</navigation>