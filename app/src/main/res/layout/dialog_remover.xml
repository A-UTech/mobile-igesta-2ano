<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/branco"
        app:cardCornerRadius="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="45dp">

            <TextView
                android:id="@+id/textView33"
                android:layout_width="194dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="74dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/poppins_medium"
                android:lineHeight="30dp"
                android:text="Remover funcionário?"
                android:textAlignment="center"
                android:textColor="@color/preto"
                android:textSize="30sp"
                app:layout_constraintEnd_toStartOf="@+id/textView38"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/textView38"
                app:layout_constraintTop_toBottomOf="@+id/bt_voltar_historico" />

            <TextView
                android:id="@+id/textView38"
                android:layout_width="268dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="37dp"
                android:fontFamily="@font/poppins_regular"
                android:lineHeight="20dp"
                android:text="Essa ação irá excluir a conta do funcionário e só é possível recuperá-la criando novamente."
                android:textAlignment="center"
                android:textColor="@color/preto"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView33" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="48dp"
                android:layout_marginTop="7dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView38">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bt_n_remover"
                    android:layout_width="115dp"
                    android:layout_height="66dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/vermelho"
                    android:fontFamily="@font/poppins_medium"
                    android:paddingVertical="10dp"
                    android:text="Não"
                    android:textAllCaps="false"
                    android:textColor="@color/branco"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bt_cadastrar_func_dialog"
                    android:layout_width="115dp"
                    android:layout_height="66dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/verde_escuro"
                    android:fontFamily="@font/poppins_medium"
                    android:paddingVertical="10dp"
                    android:text="Sim"
                    android:textAllCaps="false"
                    android:textColor="@color/branco"
                    app:cornerRadius="14dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/bt_voltar_historico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="131dp"
                android:layout_marginTop="44dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_alerta" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>