<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/branco"
        app:cardCornerRadius="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <TextView
            android:id="@+id/textView33"
            android:layout_width="194dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="74dp"
            android:layout_marginTop="60dp"
            android:fontFamily="@font/poppins_medium"
            android:lineHeight="35dp"
            android:text="Cadastrar funcionário"
            android:textAlignment="center"
            android:textColor="@color/preto"
            android:textSize="30sp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/input_nome_funcionario"
            android:layout_width="279dp"
            android:layout_height="65dp"
            android:layout_marginHorizontal="30dp"
            android:layout_marginTop="169dp"
            android:accessibilityHeading="false"
            android:background="@drawable/borda_edittext"
            android:fontFamily="@font/poppins_regular"
            android:hint="Nome"
            android:paddingLeft="25dp"
            android:singleLine="true"
            android:textColor="@color/black"
            android:textColorHint="@color/cinza_medio"
            android:textSize="13dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/input_email_funcionario"
            android:layout_width="279dp"
            android:layout_height="65dp"
            android:layout_marginHorizontal="30dp"
            android:layout_marginTop="241dp"
            android:accessibilityHeading="false"
            android:background="@drawable/borda_edittext"
            android:fontFamily="@font/poppins_regular"
            android:hint="E-mail"
            android:paddingLeft="25dp"
            android:singleLine="true"
            android:textColor="@color/black"
            android:textColorHint="@color/cinza_medio"
            android:textSize="13dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bt_cadastrar_func_dialog"
            android:layout_width="279dp"
            android:layout_height="75dp"
            android:layout_marginHorizontal="30dp"
            android:layout_marginTop="313dp"
            android:layout_marginBottom="73dp"
            android:layout_weight="1"
            android:backgroundTint="@color/verde_escuro"
            android:fontFamily="@font/poppins_medium"
            android:paddingVertical="10dp"
            android:text="Cadastrar"
            android:textAllCaps="false"
            android:textColor="@color/branco"
            app:cornerRadius="14dp" />

    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>