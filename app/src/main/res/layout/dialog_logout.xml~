<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/branco"
        app:cardCornerRadius="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <TextView
            android:id="@+id/textView33"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="61dp"
            android:layout_marginTop="52dp"
            android:fontFamily="@font/poppins_medium"
            android:text="Sair da conta?"
            android:textAlignment="center"
            android:textColor="@color/preto"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/textView38"
            android:layout_width="238dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="52dp"
            android:layout_marginTop="102dp"
            android:fontFamily="@font/poppins_regular"
            android:lineHeight="20dp"
            android:text="Você será desconectado e precisará entrar novamente para acessar sua conta."
            android:textAlignment="center"
            android:textColor="@color/preto"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="48dp"
            android:layout_marginTop="176dp"
            android:layout_marginBottom="35dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bt_n_remover"
                android:layout_width="115dp"
                android:layout_height="66dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/vermelho"
                android:fontFamily="@font/poppins_medium"
                android:paddingVertical="10dp"
                android:text="Não"
                android:textAllCaps="false"
                android:textColor="@color/branco"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bt_remover_dialog"
                android:layout_width="115dp"
                android:layout_height="66dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/verde_escuro"
                android:fontFamily="@font/poppins_medium"
                android:paddingVertical="10dp"
                android:text="Sim"
                android:textAllCaps="false"
                android:textColor="@color/branco"
                app:cornerRadius="14dp" />
        </LinearLayout>

    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>