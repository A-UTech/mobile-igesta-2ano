<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    tools:context=".Chatbot">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/shapeableImageView5"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="43dp"
            android:layout_marginTop="43dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full"
            app:srcCompat="@mipmap/fotoperfil" />

        <TextView
            android:id="@+id/textView36"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="48dp"
            android:fontFamily="@font/poppins_medium"
            android:text="Olá!"
            android:textColor="@color/cinza_medio"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.006"
            app:layout_constraintStart_toEndOf="@+id/shapeableImageView5"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageView12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="44dp"
            android:layout_marginTop="45dp"
            android:src="@drawable/seta_verde"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/shapeableImageView5" />

        <TextView
            android:id="@+id/textView37"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="40dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Igestinha"
            android:textColor="@color/verde_escuro"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/imageView12"
            app:layout_constraintTop_toBottomOf="@+id/textView36" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/mensagem_input"
            android:layout_width="match_parent"
            android:layout_height="51dp"
            android:layout_marginHorizontal="22dp"
            android:layout_marginBottom="95dp"
            android:background="@drawable/searchbar"
            android:drawableEnd="@drawable/enviar_mensagem"
            android:drawablePadding="10dp"
            android:fontFamily="@font/poppins_regular"
            android:hint="Digite sua mensagem"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:textColor="@color/preto"
            android:textColorHint="@color/cinza_escuro"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/recyclerView" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="1dp"
            app:layout_constraintBottom_toTopOf="@+id/mensagem_input"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView37"

        <LinearLayout
            android:id="@+id/chat_esquerda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/mensagem_bot"
            android:paddingHorizontal="25dp"
            android:paddingVertical="20dp"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="209dp">

            <TextView
                android:id="@+id/chat_esquerda_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="Como posso te ajudar hoje?"
                android:textColor="@color/preto"
                android:textSize="13sp"></TextView>
        </LinearLayout>
        />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>