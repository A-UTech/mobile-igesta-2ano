<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.GerenciarFuncionario">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/branco">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/bt_adicionar_funcionario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="103dp"
            android:clickable="true"
            android:contentDescription="Adicionar funcionário"
            android:src="@drawable/ic_adicionar"
            app:fabCustomSize="78dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.909"
            app:layout_constraintStart_toStartOf="parent"
            app:useCompatPadding="false" />

        <TextView
            android:id="@+id/txt_ola_gf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="48dp"
            android:fontFamily="@font/poppins_medium"
            android:text="Olá!"
            android:textColor="@color/cinza_medio"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/imageFuncionarioGerenciar"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView16"
            android:layout_width="185dp"
            android:layout_height="62dp"
            android:layout_marginStart="25dp"
            android:layout_marginTop="25dp"
            android:fontFamily="@font/poppins_semibold"
            android:lineHeight="28dp"
            android:text="Gerenciar Funcionários"
            android:textColor="@color/verde_escuro"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/bt_voltar_gf"
            app:layout_constraintTop_toBottomOf="@+id/imageFuncionarioGerenciar" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/search_funcionarios"
            android:layout_width="match_parent"
            android:layout_height="51dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="27dp"
            android:layout_marginRight="30dp"
            android:background="@drawable/searchbar"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:fontFamily="@font/poppins_regular"
            android:hint="Pesquisar funcionários"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="@color/preto"
            android:textColorHint="@color/cinza_escuro"
            android:textColorLink="@color/preto"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView16" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="26dp"
            android:paddingBottom="180dp"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/search_funcionarios"
            app:layout_constraintVertical_bias="0.0"
            tools:listitem="@layout/item_funcionario" />

        <ImageView
            android:id="@+id/bt_voltar_gf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="38dp"
            android:layout_marginTop="45dp"
            android:src="@drawable/ic_seta_verde"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageFuncionarioGerenciar" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imageFuncionarioGerenciar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="43dp"
            android:layout_marginTop="43dp"
            android:src="@mipmap/fotoperfil"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>