<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.horarioturno.HorarioTurno">

    <TextView
        android:id="@+id/selecionar_condenas_title"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:layout_marginTop="100dp"
        android:fontFamily="@font/poppins_semibold"
        android:lineHeight="30dp"
        android:text="Insira o horário dos turnos"
        android:textColor="@color/black"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/bt_selecionar"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginHorizontal="50dp"
        android:layout_marginBottom="45dp"
        android:background="@drawable/chip"
        android:backgroundTint="@color/preto"
        android:fontFamily="@font/poppins_medium"
        android:text="Concluído"
        android:textAllCaps="false"
        android:textColor="@color/branco"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.503"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="40dp"
        app:layout_constraintBottom_toTopOf="@+id/bt_selecionar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/selecionar_condenas_title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="50dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Manhã"
                    android:textColor="@color/preto" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_horario_inicio_manha"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:background="@drawable/borda_edittext"
                    android:fontFamily="@font/poppins_regular"
                    android:hint="Horário de início"
                    android:inputType="datetime|time"
                    android:paddingLeft="25dp"
                    android:paddingTop="10dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="10dp"
                    android:singleLine="true"
                    android:textColor="@color/black"
                    android:textColorHint="@color/cinza_medio"
                    android:textCursorDrawable="@drawable/custom_cursor"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_horario_termino_manha"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/borda_edittext"
                    android:fontFamily="@font/poppins_regular"
                    android:hint="Horário de início"
                    android:inputType="datetime|time"
                    android:paddingLeft="25dp"
                    android:paddingTop="10dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="10dp"
                    android:singleLine="true"
                    android:textColor="@color/black"
                    android:textColorHint="@color/cinza_medio"
                    android:textCursorDrawable="@drawable/custom_cursor"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="45dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Tarde"
                    android:textColor="@color/preto" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_horario_inicio_tarde"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:background="@drawable/borda_edittext"
                    android:fontFamily="@font/poppins_regular"
                    android:hint="Horário de início"
                    android:inputType="datetime|time"
                    android:paddingLeft="25dp"
                    android:paddingTop="10dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="10dp"
                    android:singleLine="true"
                    android:textColor="@color/black"
                    android:textColorHint="@color/cinza_medio"
                    android:textCursorDrawable="@drawable/custom_cursor"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_horario_termino_tarde"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/borda_edittext"
                    android:fontFamily="@font/poppins_regular"
                    android:hint="Horário de início"
                    android:inputType="datetime|time"
                    android:paddingLeft="25dp"
                    android:paddingTop="10dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="10dp"
                    android:singleLine="true"
                    android:textColor="@color/black"
                    android:textColorHint="@color/cinza_medio"
                    android:textCursorDrawable="@drawable/custom_cursor"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="45dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Noite"
                    android:textColor="@color/preto" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_horario_inicio_noite"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:background="@drawable/borda_edittext"
                    android:fontFamily="@font/poppins_regular"
                    android:hint="Horário de início"
                    android:inputType="datetime|time"
                    android:paddingLeft="25dp"
                    android:paddingTop="10dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="10dp"
                    android:singleLine="true"
                    android:textColor="@color/black"
                    android:textColorHint="@color/cinza_medio"
                    android:textCursorDrawable="@drawable/custom_cursor"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_horario_termino_noite"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/borda_edittext"
                    android:fontFamily="@font/poppins_regular"
                    android:hint="Horário de início"
                    android:inputType="datetime|time"
                    android:paddingLeft="25dp"
                    android:paddingTop="10dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="10dp"
                    android:singleLine="true"
                    android:textColor="@color/black"
                    android:textColorHint="@color/cinza_medio"
                    android:textCursorDrawable="@drawable/custom_cursor"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>